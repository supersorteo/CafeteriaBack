# Copia este archivo como .env y completa los valores. El .env real NO se sube a GitHub.

# Base de datos (PostgreSQL local)
DB_URL=jdbc:postgresql://localhost:5432/cafeteria
DB_USER=postgres
DB_PASSWORD=cambia-esto

# Cloudinary (en local las imagenes van a disco; estas claves se usan en produccion)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Correo (Gmail por SMTP: contrasena de aplicacion de 16 letras, sin espacios)
MAIL_FROM=tu-correo@gmail.com
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=contrasena-de-aplicacion

# Contrasena de las cuentas de demostracion del seed (solo desarrollo)
SEED_DEV_PASSWORD=DevPass123!
